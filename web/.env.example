# Base URL of the Recupero FastAPI service that serves the /v2 API.
# Local dev: the API runs on :8000; in prod point at the deployed API origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OPTIONAL: put the ENTIRE site behind HTTP Basic auth (landing, academy,
# dashboard) so a link can be shared for review without being public.
# Leave UNSET for a real/public deployment — if this is set, every visitor
# (and the Stripe checkout return hop) gets a 401 password prompt.
# PREVIEW_PASSWORD=choose-something-private
