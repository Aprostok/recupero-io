# Base URL of the Recupero FastAPI service that serves the /v2 API.
# Local dev: the API runs on :8000; in prod point at the deployed API origin.
# Baked in at BUILD time by Next — set it before `next build`, not after.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional site-wide preview password (src/middleware.ts). When set at build
# time, every route sits behind HTTP Basic auth with this as the password and
# any username — used to share the site for review while it is unlaunched.
# Leave UNSET to serve the site publicly; that is the launch configuration.
# Never hardcode this in middleware.ts: this repository is public.
# PREVIEW_PASSWORD=
